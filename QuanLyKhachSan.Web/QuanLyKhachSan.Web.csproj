<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>QuanLyKhachSan.Web</RootNamespace>
    <AssemblyName>QuanLyKhachSan.Web</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>

  <!-- Dùng chung tầng Models/Repositories/Services với ứng dụng WinForms (không chứa mã giao diện) thay vì viết lại nghiệp vụ.
       Chỉ lấy các lớp đọc dữ liệu cần cho trang tra cứu công khai. -->
  <ItemGroup>
    <Compile Include="..\QuanLyKhachSan\Repositories\Database.cs" Link="Shared\Repositories\Database.cs" />
    <Compile Include="..\QuanLyKhachSan\Repositories\PhongRepository.cs" Link="Shared\Repositories\PhongRepository.cs" />
    <Compile Include="..\QuanLyKhachSan\Repositories\LoaiPhongRepository.cs" Link="Shared\Repositories\LoaiPhongRepository.cs" />
    <Compile Include="..\QuanLyKhachSan\Models\Phong.cs" Link="Shared\Models\Phong.cs" />
    <Compile Include="..\QuanLyKhachSan\Models\LoaiPhong.cs" Link="Shared\Models\LoaiPhong.cs" />
    <Compile Include="..\QuanLyKhachSan\Services\PhongService.cs" Link="Shared\Services\PhongService.cs" />
    <Compile Include="..\QuanLyKhachSan\Services\IPhongService.cs" Link="Shared\Services\IPhongService.cs" />
    <Compile Include="..\QuanLyKhachSan\Services\LoaiPhongService.cs" Link="Shared\Services\LoaiPhongService.cs" />
    <Compile Include="..\QuanLyKhachSan\Services\ILoaiPhongService.cs" Link="Shared\Services\ILoaiPhongService.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

</Project>
